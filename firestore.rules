rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mapas dos shoppings: qualquer usuário logado lê; só você (pelo console) edita.
    match /shoppings/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Favoritos de cada usuário: só o dono lê e escreve.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Sugestões de correção: o usuário cria e pode apagar as próprias (exclusão de conta).
    match /sugestoes/{id} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() <= 1000;
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
